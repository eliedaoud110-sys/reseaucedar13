
{
  "rules": {
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "teachers": {
      ".read": "auth != null",
      ".write": false
    },
    "messages": {
      ".read": "auth != null",
      "$messageId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teachers').child(auth.uid).val() === true)"
      }
    },
    "links": {
      ".read": "auth != null",
      "$linkId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    }
  }
}
